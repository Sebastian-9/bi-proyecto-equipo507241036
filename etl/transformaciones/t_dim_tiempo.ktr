    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var fecha_limpia = "";

if (FECHA_DESPACHO != null) {
    var strFecha = FECHA_DESPACHO.trim();
    var fechaObj = new Date(strFecha);

    if (isNaN(fechaObj.getTime())) {
        fechaObj = new Date(Date.parse(strFecha));
    }

    if (!isNaN(fechaObj.getTime())) {
        var anio = fechaObj.getFullYear();
        var mes = fechaObj.getMonth() + 1;
        var dia = fechaObj.getDate();

        var mes_s = mes &lt; 10 ? '0' + mes : '' + mes;
        var dia_s = dia &lt; 10 ? '0' + dia : '' + dia;

        fecha_limpia = anio + '-' + mes_s + '-' + dia_s;
    }
}</jsScript_script>
      </jsScript>
    </jsScripts>
